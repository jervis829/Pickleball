# 复制为 .deploy.env 后填入真实值；该文件已被 .gitignore 排除，绝不入库。
# 用法：填好后回我一句，我执行部署与真机验证。

# ---- SSH 连接 ----
DEPLOY_HOST=
DEPLOY_PORT=22
DEPLOY_USER=root

# 认证二选一：优先私钥（填本机绝对路径）；没有再用密码
DEPLOY_KEY=
DEPLOY_PWD=

# ---- 部署目标 ----
DEPLOY_DIR=/opt/pickleball
# 应用监听地址：0.0.0.0 = 公网直连；127.0.0.1 = 仅本机，需 Nginx 反代
DEPLOY_BIND=0.0.0.0
DEPLOY_APP_PORT=8787
DEPLOY_SERVICE=pickleball
DEPLOY_CHECK_URL=http://127.0.0.1:8787/api/v1/health

# ---- 可选：部署完成后用于外网访问的域名（留空则不配置 Nginx）----
DEPLOY_DOMAIN=
