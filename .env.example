# ---- 服务 ----
PORT=8787
HOST=127.0.0.1
DB_FILE=data/pickleball.db

# ---- 鉴权 ----
ADMIN_USER=admin
# 留空：首次启动自动生成随机密码，写入 data/initial-admin.txt 并在控制台打印
ADMIN_PASSWORD=
# 留空：首次启动自动生成并保存 data/jwt-secret.txt
JWT_SECRET=
JWT_TTL_SECONDS=900

# ---- 安全 ----
# 逗号分隔的「额外」允许来源（真正跨域接入时填写，例：https://partner.example）
# 本站同源来源自动放行：直连本地、以及经 Nginx/HTTPS 反代访问的域名与 www 子域，
# 由请求 Host / X-Forwarded-Host 推导，无需在此重复填写域名。
CORS_ORIGINS=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600
NODE_ENV=development

# ---- GitHub 推送（仅本地使用，绝不入库）----
# 在 GitHub → Settings → Developer settings → Personal access tokens 生成
# 经典 PAT 勾选 repo，或细粒度 PAT 授予本仓库 Contents: Read & Write
# 写入 .env 后执行：bash scripts/publish-to-github.sh
GITHUB_PAT=
