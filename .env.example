# ---- 服务 ----
PORT=8787
# 默认只监听本机；在容器 / 云预览环境里需要外部访问时改为 0.0.0.0
HOST=127.0.0.1
DB_FILE=data/pickleball.db
# 允许把界面嵌入到哪些宿主来源（逗号分隔，精确来源，不支持 *）。
# 留空 = 发送 X-Frame-Options: DENY，禁止任何站点内嵌（默认，防点击劫持）。
# 例：云预览域名 ALLOW_EMBED_ORIGINS=https://8787-xxxx.e2b.app
ALLOW_EMBED_ORIGINS=

# ---- 鉴权 ----
ADMIN_USER=admin
# 留空：首次启动自动生成随机密码，写入 data/initial-admin.txt 并在控制台打印
ADMIN_PASSWORD=
# 留空：首次启动自动生成并保存 data/jwt-secret.txt
JWT_SECRET=
# 登录有效期（秒）。默认 12 小时 = 一个营业日，避免教练每 15 分钟被弹一次登录框。
JWT_TTL_SECONDS=43200
# 令牌到期后仍可静默续期的宽限（秒）。应对笔记本合盖 / 标签页休眠后回来。
JWT_REFRESH_GRACE_SECONDS=3600

# ---- 安全 ----
# 逗号分隔的「额外」允许来源（真正跨域接入时填写，例：https://partner.example）
# 本站同源来源自动放行：直连本地、以及经 Nginx/HTTPS 反代访问的域名与 www 子域，
# 由请求 Host / X-Forwarded-Host 推导，无需在此重复填写域名。
CORS_ORIGINS=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600
NODE_ENV=development

# ---- GitHub 推送（仅本地使用，绝不入库）----
# 在 GitHub → Settings → Developer settings → Personal access tokens 生成
# 经典 PAT 勾选 repo，或细粒度 PAT 授予本仓库 Contents: Read & Write
# 写入 .env 后执行：bash scripts/publish-to-github.sh
GITHUB_PAT=
