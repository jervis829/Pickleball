# ---- 服务 ----
PORT=8787
HOST=127.0.0.1
DB_FILE=data/pickleball.db

# ---- 鉴权 ----
ADMIN_USER=admin
# 留空：首次启动自动生成随机密码，写入 data/initial-admin.txt 并在控制台打印
ADMIN_PASSWORD=
# 留空：首次启动自动生成并保存 data/jwt-secret.txt
JWT_SECRET=
JWT_TTL_SECONDS=900

# ---- 安全 ----
# 逗号分隔的允许来源；同源部署留空即可
CORS_ORIGINS=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600
NODE_ENV=development
