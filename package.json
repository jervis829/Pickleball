{
  "name": "pickleball-academy",
  "version": "1.0.0",
  "private": true,
  "description": "匹克球教学管理平台 · 全栈版（Node.js + SQLite + 零依赖）",
  "scripts": {
    "start": "node backend/src/index.js",
    "dev": "node --watch backend/src/index.js",
    "migrate": "node backend/src/db/migrate.js",
    "seed": "node database/seeds/seed.js",
    "test": "node --test backend/tests/*.test.js && npm run check:curriculum && npm run check:frontend",
    "check": "node --check backend/src/index.js",
    "check:curriculum": "node scripts/check-curriculum.js",
    "check:frontend": "node scripts/check-frontend.js"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
